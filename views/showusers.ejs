<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>All Users</title>
    <style>
        table,tr,td{
            border: 1px solid black;
        }
    </style>
</head>
<body>
    <form method="GET" action="/user/add">
        <button>Add User In Database</button>
    </form>
    <br>
    <br>
    <table>
        <tr>
            <td>Id</td>
            <td>username</td>
            <td>emailId</td>
        </tr>
            <% for(user of users) { %>
                <tr>
                    <td><%= user.id %></td>
                    <td><%= user.user %></td>
                    <td><%= user.email %></td>
                    <td>
                        <form method="GET" action="/user/<%= user.id %>/edit">
                            <button>Edit username</button>
                        </form>
                    </td>
                    <td>
                        <form method="GET" action="/user/<%= user.id %>/delete">
                            <button>Delete User</button>
                        </form>
                    </td>
                    
                </tr>
                <%} %>
    </table>
    
</body>
</html>

