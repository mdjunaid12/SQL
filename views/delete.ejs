<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Delete</title>
</head>
<body>
    <h2>You are deleting user:<%= user.user%></h2>
    <form method="post" action="/user/<%=user.id%>?_method=DELETE"  >
        <label for="email">enter your email:</label> <br>
        <input type="text" id="email" placeholder="enter your email" name="email"> <br>
        <br>

        <label for="password">enter your password:</label> <br>
        <input type="password" id="password" placeholder="enter your password" name="password"> <br>
        <br>
        
        <button>Delete</button>
    </form>
</body>
</html>